{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay-watch",
  "account_id": "d04285a86d0191dfd65ada4e7de82ff9",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/api/*"]
  },
  "routes": [
    {
      "pattern": "gptcheck.ccwu.cc",
      "custom_domain": true
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "excut164@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relay-watch",
      "database_id": "f46b0aa5-cc7b-4769-8485-18e1dcb2af8e"
    }
  ]
}
